{
  "family": "examapp-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::809472479011:role/examapp-ecs-task-exec-role",
  "taskRoleArn": "arn:aws:iam::809472479011:role/examapp-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "809472479011.dkr.ecr.eu-west-1.amazonaws.com/examapp-backend:latest",
      "essential": true,
      "portMappings": [ { "containerPort": 3000, "protocol": "tcp" } ],
      "environment": [
        { "name": "EXAM_SOURCE", "value": "s3" },
        { "name": "AWS_REGION", "value": "eu-west-1" },
        { "name": "S3_BUCKET", "value": "examapp-exam-questions-809472479011" },
        { "name": "EXAMS_INDEX_TABLE", "value": "examapp-exams-index" },
        { "name": "ATTEMPTS_TABLE", "value": "examapp-attempts" },
        { "name": "GAM_TABLE", "value": "examapp-gamification" },
        { "name": "USERS_TABLE", "value": "examapp-users" },
        { "name": "ENTITLEMENTS_TABLE", "value": "examapp-entitlements" },
        { "name": "AUDIT_TABLE", "value": "examapp-audit" },
        { "name": "ISSUE_REPORTS_TABLE", "value": "examapp-issue-reports" },
        { "name": "IMAGES_S3_BUCKET", "value": "examapp-images-809472479011" },
        { "name": "SKILL_LAB_SOURCE", "value": "s3" },
        { "name": "SKILL_LAB_S3_BUCKET", "value": "examapp-skill-labs-809472479011" },
        { "name": "SKILL_LAB_INDEX_TABLE", "value": "examapp-skill-labs-index" },
        { "name": "SKILL_LAB_ATTEMPTS_TABLE", "value": "examapp-skill-lab-attempts" },
        { "name": "AUTH_MODE", "value": "cognito" },
        { "name": "COGNITO_DOMAIN", "value": "eu-west-1c6wqup1rx.auth.eu-west-1.amazoncognito.com" },
        { "name": "COGNITO_APP_CLIENT_ID", "value": "2b10tfhn1k9pq9rr5f6k14usc3" },
        { "name": "COGNITO_REGION", "value": "eu-west-1" },
        { "name": "COGNITO_USER_POOL_ID", "value": "eu-west-1_c6WQUP1RX" },
        { "name": "COGNITO_REDIRECT_URI", "value": "https://api.certshack.com/auth/token" },
        { "name": "FRONTEND_ORIGIN", "value": "https://certshack.com" },
        { "name": "METRICS_TABLE", "value": "examapp-metrics" },
        { "name": "INTERACTIONS_TABLE", "value": "examapp-interactions" },
        { "name": "SESSIONS_TABLE", "value": "examapp-sessions" },
        { "name": "COGNITO_ADMIN_ROLE_ARN", "value": "arn:aws:iam::030461496359:role/examapp-mgmt-cross-account-role" },
        { "name": "SES_FROM_ADDRESS", "value": "noreply@certshack.com" },
        { "name": "SES_SUPPORT_ADDRESS", "value": "support@certshack.com" },
        { "name": "STRIPE_PRICE_ID_MONTHLY", "value": "price_1THKKkRXOMjZneV7ptKVgxPT" },
        { "name": "STRIPE_PRICE_ID_ANNUAL",  "value": "price_1THKLCRXOMjZneV7bUdaFcDz" },
        { "name": "PAYPAL_CLIENT_ID", "value": "AbyHVazM-r_fPb1CgQa0j5nwTtdMawkxoHGa2Dxd9PavViGd1G4Z0qTiHONgx1hUMC7ONUYKLBbrU4wa" },
        { "name": "PAYPAL_API_BASE", "value": "https://api-m.paypal.com" },
        { "name": "PAYPAL_PLAN_ID_MONTHLY", "value": "P-6YD57S96FT336305SNHG0NWY" },
        { "name": "PAYPAL_PLAN_ID_ANNUAL", "value": "P-8NL966S2UY946S01NHGO0IY" },
        { "name": "PAYPAL_WEBHOOK_ID", "value": "3B392581WH426842V" },
        { "name": "RATE_LIMIT_MAX", "value": "100" }
