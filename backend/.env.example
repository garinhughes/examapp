# Backend example environment
# Copy to .env and edit values. Do NOT commit secrets (client secrets, AWS keys, etc.).

# Server
PORT=3000
# Optional: override max requests per minute per IP (default: 200)
# RATE_LIMIT_MAX=200

# Auth mode: 'dev' (inject mock user) or 'cognito' (verify tokens)
AUTH_MODE=dev

# Dev user (used when AUTH_MODE=dev)
DEV_USER_ID=dev-user-001
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME=Dev User

# Cognito config (non-sensitive values)
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
# Public client id
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
# Private client secret
COGNITO_APP_CLIENT_SECRET=your-client-secret
# Cognito hosted UI domain (no scheme)
COGNITO_DOMAIN=your-cognito-domain.auth.eu-west-1.amazoncognito.com
# Local dev only: AWS profile to use for Cognito admin operations.
# Use when the Cognito pool is in a different account from your default credentials.
# COGNITO_AWS_PROFILE=mgmt
# Optional: ARN of IAM role to assume for cross-account Cognito admin calls (production)
# COGNITO_ADMIN_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/examapp-mgmt-cross-account-role

# Optional: redirect URI for confidential client flow (server callback)
# If omitted the backend defaults to http://localhost:3000/auth/token
# COGNITO_REDIRECT_URI=http://localhost:3000/auth/token

# Origins — used for CORS, redirects and email link generation
# FRONTEND_ORIGIN=http://localhost:5173
# BACKEND_ORIGIN=http://localhost:3000

# Exam source: 'local' (read from data/exams/) or 's3' (read from S3 + DynamoDB index)
EXAM_SOURCE=local

# S3 buckets (used when source=s3)
EXAM_BUCKET=examapp-exams-prod
EXAM_INDEX_TABLE=examapp-exams-index
IMAGES_S3_BUCKET=examapp-images-prod

# Skill labs source: 'local' or 's3'
SKILL_LAB_SOURCE=local
SKILL_LAB_S3_BUCKET=examapp-skill-labs-prod
SKILL_LAB_INDEX_TABLE=examapp-skill-lab-index
SKILL_LAB_ATTEMPTS_TABLE=examapp-skill-lab-attempts

# AWS / DynamoDB (table names only; do not put credentials here)
AWS_REGION=eu-west-1
USERS_TABLE=examapp-users
ENTITLEMENTS_TABLE=examapp-entitlements
ATTEMPTS_TABLE=examapp-attempts
AUDIT_TABLE=examapp-audit
SESSIONS_TABLE=examapp-sessions
INTERACTIONS_TABLE=examapp-interactions
METRICS_TABLE=examapp-metrics
GAM_TABLE=examapp-gamification
ISSUE_REPORTS_TABLE=examapp-issue-reports

# Email (AWS SES)
SES_FROM_ADDRESS=noreply@yourdomain.com
SES_SUPPORT_ADDRESS=support@yourdomain.com
SES_OUTREACH_ADDRESS=outreach@yourdomain.com
EMAIL_TEMPLATES_TABLE=examapp-email-templates
EMAIL_LOGS_TABLE=examapp-email-logs

# Secrets — generate strong random strings for production
# openssl rand -hex 32
CERTIFICATE_SECRET=change-me-32-chars-minimum
CRON_SECRET=change-me-32-chars-minimum
UNSUBSCRIBE_SECRET=change-me-32-chars-minimum
# Days before entitlement expiry to send reminder emails (default: 7)
# EXPIRY_REMINDER_DAYS=7

# Stripe (https://dashboard.stripe.com)
# Secret key — use sk_test_... for dev, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — from Stripe Dashboard → Developers → Webhooks → endpoint → Reveal signing secret
# For local dev use the secret printed by: stripe listen --forward-to localhost:3000/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Pre-created recurring Price IDs for subscription products (Stripe Dashboard → Products)
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# PayPal (https://developer.paypal.com/dashboard/applications)
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Webhook ID from PayPal dashboard → Webhooks (used for signature verification)
# PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Override API base for sandbox testing (omit in production to use live)
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Billing Plan IDs — create plans in PayPal dashboard → Subscriptions → Plans
# PAYPAL_PLAN_ID_MONTHLY=P-XXXXXXXXXXXXXXXXXXXXXXXX
# PAYPAL_PLAN_ID_ANNUAL=P-XXXXXXXXXXXXXXXXXXXXXXXX

# GitHub token (used for admin tooling, optional)
# GITHUB_TOKEN=ghp_...
